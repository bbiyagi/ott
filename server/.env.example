# 이 파일을 server/.env로 복사해서 값을 채운다. Vercel에서는 같은 이름으로 환경 변수에 넣는다.

# 네이버 검색 API (developers.naver.com > Application 등록 > 검색)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Claude API (platform.claude.com > API Keys)
ANTHROPIC_API_KEY=

# TMDB API 읽기 액세스 토큰 (themoviedb.org > 설정 > API > API Read Access Token)
TMDB_TOKEN=

# KOBIS 오픈API 키 (kobis.or.kr/kobisopenapi > 키 발급)
KOBIS_KEY=

# 저장소: Upstash Redis. 비워 두면 로컬은 server/data/*.json 파일에 저장
# Vercel > Storage > Upstash for Redis로 만들면 KV_REST_API_URL/TOKEN이 자동으로 들어간다
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 예약 수집 보호용 임의 문자열. GitHub Actions 시크릿에도 같은 값
CRON_SECRET=

# 테스트용 오늘 날짜 고정 (예: 2026-10-08)
# TODAY_OVERRIDE=
